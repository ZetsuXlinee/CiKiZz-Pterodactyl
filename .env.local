# ==========================================
# 3. KONFIGURASI APLIKASI & AUTENTIKASI (NextAuth)
# ==========================================
# Saat testing di lokal pakai http://localhost:3000
# Saat deploy ke Vercel ganti jadi https://cikizz-pterodactyl.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Generate string random untuk SECRET (Bisa pakai: https://generate-secret.vercel.app/32)
NEXTAUTH_SECRET=buat_string_random_panjang_disini_minimal_32_karakter
# Token rahasia untuk komunikasi antar API internal (webhook ke provisioning)
INTERNAL_TOKEN=token_rahasia_internal_bebas_apa_saja_tapi_panjang

# ==========================================
# 4. KONFIGURASI DATABASE (WAJIB POSTGRESQL)
# ==========================================
# Karena mau deploy ke Vercel, TIDAK BISA pakai SQLite.
# Gunakan database gratis dari Neon.tech, Supabase, atau Vercel Postgres.
# Contoh format:
# DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/cikizz_db?schema=public"

# ==========================================
# 5. KONFIGURASI EMAIL (RESEND)
# ==========================================
# Daftar gratis di resend.com untuk mendapatkan API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@domainkamu.com